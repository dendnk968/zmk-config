#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

&mmv {
};

&msc {
};

&tog {
};

&sl {
};

&kt {
};

/ {
    macros {
        change_ru: change_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>, <&macro_wait_time 50>, <&to 1>;

            label = "CHANGE_RU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp LWIN  &none  &mt SEMICOLON COLON  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &kp P         &kp Y        &kp F      &kp G       &kp C  &kp R          &kp L  &kp BACKSPACE  &mt RWIN RBKT
          &none  &kp A                &kp O                &kp E                    &kp U         &kp I        &kp D      &kp H       &kp T  &kp N          &kp S  &kp MINUS
          &none  &mt SQT LS(SQT)      &kp Q                &kp J                    &kp K         &kp X        &kp B      &kp M       &kp W  &kp V          &kp Z  &none
                                      &change_ru           &none                    &lt 2 DELETE  &kp SPACE    &kp ENTER  &lt 2 PIPE  &to 3  &kp RIGHT_GUI
            >;
        };

        ru {
            bindings = <
&trans  &kp Q  &kp W  &kp E   &kp R   &kp T   &kp Y        &kp U      &kp I      &kp O    &kp P     &kp LBKT  &kp BACKSPACE  &trans
        &kp A  &kp S  &kp D   &kp F   &kp G   &kp H        &kp J      &kp K      &kp L    &kp SEMI  &kp APOS  &trans
        &kp Z  &kp X  &kp C   &kp V   &kp B   &kp N        &kp M      &kp COMMA  &kp DOT  &kp FSLH  &trans    &trans
                      &trans  &trans  &trans  &kp SPACE    &kp ENTER  &trans     &trans   &trans
            >;
        };

        numb_and_progger {
            bindings = <
&trans  &none  &mt RIGHT_PARENTHESIS LEFT_PARENTHESIS  &mt RIGHT_BRACKET LEFT_BRACKET  &mt RIGHT_BRACE LEFT_BRACE  &mt GREATER_THAN LESS_THAN  &none     &none   &kp N7        &kp N8        &kp N9        &kp PLUS      &none  &mt RGUI F12
        &none  &none                                   &kp PERCENT                     &mt PIPE AMPERSAND          &mt EQUAL EXCLAMATION       &none     &none   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS     &none
        &none  &none                                   &none                           &none                       &none                       &none     &none   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK  &none
                                                       &trans                          &none                       &trans                      &trans    &trans  &trans        &kp N0        &trans
            >;
        };

        mouse_and_hot_keys {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP    &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans           &trans          &trans
                        &trans  &trans  &trans  &trans    &trans  &trans          &trans          &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp KP_NUM       &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS    &kp C_VOL_UP  &kp HOME  &kp PSCRN  &kp PG_UP  &kp SLCK         &kp CAPS         &trans
        &mt LCTRL EQUAL  &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS     &kp C_MUTE    &kp LEFT  &kp UP     &kp RIGHT  &kp INS          &mt RCTRL K_APP
        &trans           &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT      &kp C_VOL_DN  &kp END   &kp DOWN   &kp PG_DN  &kp PAUSE_BREAK  &trans
                                          &trans     &trans     &trans     &lt 5 RET       &lt 5 ESC     &trans    &trans     &trans
            >;
        };

        adjust_layer {
            bindings = <
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };
};
